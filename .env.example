# Copy this file to .env and change the values before running in production.

# --- Supabase project settings ---------------------------------------------
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: server-side ONLY. Never send this to the frontend/browser.
# Used for admin auth calls (creating users in seed.py, promoting roles) and
# bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings -> API -> JWT Settings -> JWT Secret. Used to verify the
# access tokens Supabase Auth issues, without a network round trip.
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Database (SQLAlchemy) --------------------------------------------------
# Project Settings -> Database -> Connection string ("Session pooler" or
# "Transaction pooler" both work; use the pooler, not the direct connection,
# for anything serverless). This connects as a privileged Postgres role
# (usually `postgres`), which owns the tables and therefore bypasses RLS by
# default -- RLS still fully protects the data for anyone/anything that
# connects as `anon` or `authenticated` instead (e.g. Supabase Realtime, or
# a future direct-from-frontend Supabase client). See SUPABASE_INTEGRATION.md.
DATABASE_URL=postgresql+psycopg://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# If true, the database is populated with demo data the first time it is empty
SEED_DEMO_DATA=true

# Credentials for the initial admin account created by the seed script
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_EMAIL=admin@mechflow.local
